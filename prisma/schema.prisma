generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── AUTH (NextAuth v5) ───────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts   Account[]
  sessions   Session[]
  characters Character[]
  campaigns  CampaignMember[]
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// ─── SISTEMAS DE RPG ─────────────────────────────────────────────────────────

model System {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  version     String
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  characters Character[]
  campaigns  Campaign[]
}

// ─── PERSONAGEM (núcleo agnóstico de sistema) ─────────────────────────────────

model Character {
  id          String   @id @default(cuid())
  userId      String
  systemId    String
  name        String
  portraitUrl String?
  notes       String?
  isPublic    Boolean  @default(false)
  shareToken  String   @unique @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  system System @relation(fields: [systemId], references: [id])

  dndSheet           DndSheet?
  tormentaSheet      TormentaSheet?
  cthulhuSheet       CthulhuSheet?
  ordemSheet         OrdemSheet?
  starWarsSheet      StarWarsSheet?
  campaignCharacters CampaignCharacter[]
}

// ─── D&D 5e ──────────────────────────────────────────────────────────────────

model DndSheet {
  id        String    @id
  character Character @relation(fields: [id], references: [id], onDelete: Cascade)

  race       String?
  background String?
  alignment  String?
  xp         Int     @default(0)
  level      Int     @default(1)

  str Int @default(10)
  dex Int @default(10)
  con Int @default(10)
  int Int @default(10)
  wis Int @default(10)
  cha Int @default(10)

  hpMax             Int     @default(10)
  hpCurrent         Int     @default(10)
  hpTemp            Int     @default(0)
  hitDice           String?
  hitDiceUsed       Int     @default(0)
  deathSavesSuccess Int     @default(0)
  deathSavesFailure Int     @default(0)

  armorClass  Int     @default(10)
  initiative  Int     @default(0)
  speed       Int     @default(30)
  inspiration Boolean @default(false)

  cp Int @default(0)
  sp Int @default(0)
  ep Int @default(0)
  gp Int @default(0)
  pp Int @default(0)

  conditions     String? // JSON: string[]
  spellSlotsUsed String? // JSON: {"1": 0, "2": 0, ...} slots used per level
  spellAbility   String? // atributo de conjuração escolhido (sobrepõe o padrão da classe)

  classes   DndClass[]
  skills    DndSkill[]
  spells    DndSpell[]
  equipment DndEquipment[]
  features  DndFeature[]
}

model DndClass {
  id        String  @id @default(cuid())
  sheetId   String
  className String
  subclass  String?
  level     Int

  sheet DndSheet @relation(fields: [sheetId], references: [id], onDelete: Cascade)
}

model DndSkill {
  id         String  @id @default(cuid())
  sheetId    String
  skillName  String
  proficient Boolean @default(false)
  expertise  Boolean @default(false)

  sheet DndSheet @relation(fields: [sheetId], references: [id], onDelete: Cascade)

  @@unique([sheetId, skillName])
}

model DndSpell {
  id          String  @id @default(cuid())
  sheetId     String
  spellName   String
  level       Int     @default(0)
  school      String?
  prepared    Boolean @default(false)
  description String?
  components  String?
  castingTime String?
  duration    String?
  range       String?

  sheet DndSheet @relation(fields: [sheetId], references: [id], onDelete: Cascade)
}

model DndEquipment {
  id          String  @id @default(cuid())
  sheetId     String
  itemName    String
  quantity    Int     @default(1)
  weight      Float?
  equipped    Boolean @default(false)
  description String?

  sheet DndSheet @relation(fields: [sheetId], references: [id], onDelete: Cascade)
}

model DndFeature {
  id          String  @id @default(cuid())
  sheetId     String
  name        String
  source      String?
  description String?

  sheet DndSheet @relation(fields: [sheetId], references: [id], onDelete: Cascade)
}

// ─── TORMENTA 20 ─────────────────────────────────────────────────────────────
model TormentaSheet {
  id        String    @id
  character Character @relation(fields: [id], references: [id], onDelete: Cascade)

  race        String? // slug da raça
  raceVariant String? // Suraggel: "aggelus" | "sulfure"
  className   String?
  path        String? // Arcanista: "bruxo" | "feiticeiro" | "mago"
  origin      String?
  godId       String? // devoto (Clérigo/Druida/Paladino)
  level       Int     @default(1)
  xp          Int     @default(0)

  forca Int @default(10) // "for" é palavra reservada no schema Prisma → forca
  des   Int @default(10)
  con   Int @default(10)
  int   Int @default(10)
  sab   Int @default(10)
  car   Int @default(10)

  pvMax     Int @default(10)
  pvCurrent Int @default(10)
  pvTemp    Int @default(0)
  pmMax     Int @default(10)
  pmCurrent Int @default(10)
  pmTemp    Int @default(0)

  defense  Int @default(10)
  movement Int @default(9)
  money    Int @default(0) // T$

  skills        String? // JSON: Record<skillId, boolean> (treinada)
  schoolsChosen String? // JSON: string[] (Bardo/Druida — 3 escolas)
  spellsKnown   String? // JSON: string[] (ids de magia)
  powers        String? // JSON: ChosenPower[] (poderes escolhidos ao subir de nível, ver lib/tormenta/leveling.ts)
  weapons       String? // JSON: item list
  equipment     String? // JSON: item list (armadura, escudo, itens gerais)
  conditions    String? // JSON: string[]
  background    String? // JSON: { appearance, personality, history, objective }
  notes         String?
}

// ─── CALL OF CTHULHU 7ª ED. ──────────────────────────────────────────────────

model CthulhuSheet {
  id        String    @id
  character Character @relation(fields: [id], references: [id], onDelete: Cascade)

  occupation String?
  era        String? // "1920s" | "modern"
  age        Int?

  // 8 Atributos (valores percentuais, 15–99 típico)
  atribFor Int @default(50)
  atribCon Int @default(50)
  atribTam Int @default(65)
  atribDes Int @default(50)
  atribApa Int @default(50)
  atribInt Int @default(65)
  atribPod Int @default(50)
  atribEdu Int @default(65)

  // Atributos derivados
  sanCurrent Int @default(50)
  sanMax     Int @default(99)
  pvMax      Int @default(12)
  pvCurrent  Int @default(12)
  luck       Int @default(50)
  mov        Int @default(8)
  pmCurrent  Int @default(10)

  // Pontos temporários (estilo D&D: absorvem dano antes do valor atual)
  pvTemp  Int @default(0)
  sanTemp Int @default(0)
  pmTemp  Int @default(0)

  // Desenvolvimento: ids de perícias marcadas como usadas com sucesso (JSON string[])
  skillChecks String?

  // Dados complexos como JSON
  skills       String? // JSON: Record<string, number>
  background   String? // JSON: { ideology?, people?, places?, items?, traits?, keyConn? }
  weapons      String? // JSON: weapon list
  equipment    String? // JSON: item list
  notes        String?
  insanityData String? // JSON: { sessionLoss, status, phobias, manias, notes }
  spellsData   String? // JSON: CthulhuSpell[]
}

// ─── ORDEM PARANORMAL RPG ────────────────────────────────────────────────────

model OrdemSheet {
  id        String    @id
  character Character @relation(fields: [id], references: [id], onDelete: Cascade)

  origin    String? // origem (slug)
  className String? // "combatente" | "especialista" | "ocultista"
  trail     String? // trilha da classe (slug)
  nex       Int     @default(5) // 5..99 (%)
  patente   String  @default("recruta") // recruta | operador | agente | oficial | elite

  // 5 Atributos (0–5; inicial 1)
  agi   Int @default(1)
  forca Int @default(1) // "for" é palavra reservada em vários contextos → forca
  int   Int @default(1)
  pre   Int @default(1)
  vig   Int @default(1)

  // Derivados de vida/esforço/sanidade
  pvMax      Int @default(0)
  pvCurrent  Int @default(0)
  pvTemp     Int @default(0)
  peMax      Int @default(0)
  peCurrent  Int @default(0)
  peTemp     Int @default(0)
  sanMax     Int @default(0)
  sanCurrent Int @default(0)
  sanTemp    Int @default(0)

  defense  Int     @default(10) // 10 + AGI
  movement Int     @default(9) // metros
  prestige Int     @default(0) // pontos de prestígio (patente)
  affinity String? // elemento de afinidade (NEX 50%+)

  // Dados complexos como JSON (espelha CthulhuSheet)
  skills     String? // JSON: Record<skillId, "treinado"|"veterano"|"expert">
  abilities  String? // JSON: Ability[] (poderes de classe/origem/trilha)
  rituals    String? // JSON: Ritual[]
  inventory  String? // JSON: Item[]
  weapons    String? // JSON: Weapon[]
  background String? // JSON: { name, gender, age, appearance, personality, history, objective }
  conditions String? // JSON: string[]
  insanity   String? // JSON: { traumas, phobias, manias, notes }
  notes      String?
}

// ─── STAR WARS: ALÉM DA FRONTEIRA (sistema autoral) ───────────────────────────

model StarWarsSheet {
  id        String    @id
  character Character @relation(fields: [id], references: [id], onDelete: Cascade)

  species  String? // slug da espécie
  planet   String? // slug do planeta de origem
  planetSkillChoice String? // perícia escolhida pelo jogador pra receber o +5 da Habilidade Natal (quando o planeta lista 2 opções)
  path     String? // "luz" | "neutro" | "sombrio"
  classes  String  @default("{}") // JSON: Record<classId, level> (multiclasse)
  level    Int     @default(1) // nível total (soma das classes)
  xp       Int     @default(0)
  humanAttrChoice String? // JSON: atributos escolhidos pelo Humano (+2/+2/+1/+1/+1/-1)

  agi Int @default(1)
  int Int @default(1)
  forca Int @default(1) // "for" é palavra reservada → forca
  vig Int @default(1)
  pre Int @default(1)
  sen Int @default(1)

  pvMax     Int @default(10) // = pvClassSum + pvLevelGain (recalculado a cada mudança de qualquer termo)
  pvClassSum      Int @default(0) // soma da base de PV de cada classe (pv1Base + Vig×pv1VigMult + bônus de tier, 1x por classe)
  pvLevelGain     Int @default(0) // soma do ganho de PV por subir de nível (pvPerLevelBase + Vig×pvPerLevelVigMult, por nível além do 1º de cada classe)
  pvCurrent Int @default(10)
  pvTemp    Int @default(0)
  peMax     Int @default(0) // Pontos de Energia da Força
  peCurrent Int @default(0)
  peTemp    Int @default(0)
  ppMax     Int @default(0) // Pontos de Poder (Poderes Gerais)
  ppCurrent Int @default(0)
  ppTemp    Int @default(0)

  sabreForm String? // forma de sabre especialista escolhida (5º círculo), se aplicável
  unlockedProphecies String @default("[]") // JSON: string[] (ids das classes de Profecia desbloqueadas por senha — "cantico_alvorecer" | "litania_queda")

  skills       String? // JSON: Record<skillId, grau> (inexperiente|iniciante|treinado|expert|veterano|mestre)
  classPowers  String? // JSON: ChosenPower[] (habilidades de classe escolhidas por nível)
  generalPowers String? // JSON: string[] (ids de Poderes Gerais aprendidos)
  equipment    String? // JSON: item list
  weapons      String? // JSON: weapon list
  conditions   String? // JSON: string[]
  background   String? // JSON: { organization, appearance, personality, history, objective }
  notes        String?
}

// ─── CAMPANHAS (preparado, sem área mestre ativa) ─────────────────────────────

model Campaign {
  id          String   @id @default(cuid())
  ownerId     String
  systemId    String
  name        String
  description String?
  inviteCode  String   @unique @default(cuid())
  createdAt   DateTime @default(now())

  // ── Campos do Mestre (compartilhados entre sistemas) ──
  tier          String    @default("1") // Ordem: círculo / faixa de NEX
  era           String? // Cthulhu: 1920s | modern | outro
  nextSessionAt DateTime? // agenda da próxima sessão
  notes         String?

  system     System              @relation(fields: [systemId], references: [id])
  members    CampaignMember[]
  characters CampaignCharacter[]

  ordemStory      OrdemStory?
  ordemNpcs       OrdemNpc[]
  ordemCombatants OrdemCombatant[]
  ordemSessions   OrdemGameSession[]
  ordemItems      OrdemItem[]
  ordemSanity     OrdemSanityRecord[]
  ordemClues      OrdemClue[]
  ordemClocks     OrdemClock[]
  ordemRewards    OrdemReward[]

  dndStory      DndCampaignStory?
  dndNpcs       DndNpc[]
  dndCombatants DndCombatant[]
  dndSessions   DndGameSession[]
  dndItems      DndCampaignItem[]
  dndClues      DndClue[]
  dndClocks     DndClock[]

  cthulhuStory      CthulhuCampaignStory?
  cthulhuNpcs       CthulhuNpc[]
  cthulhuCombatants CthulhuCombatant[]
  cthulhuSessions   CthulhuGameSession[]
  cthulhuItems      CthulhuCampaignItem[]
  cthulhuInsanity   CthulhuInsanityRecord[]
  cthulhuClues      CthulhuClue[]
  cthulhuClocks     CthulhuClock[]

  tormentaStory      TormentaCampaignStory?
  tormentaNpcs       TormentaNpc[]
  tormentaCombatants TormentaCombatant[]
  tormentaSessions   TormentaGameSession[]
  tormentaItems      TormentaCampaignItem[]
  tormentaClues      TormentaClue[]
  tormentaClocks     TormentaClock[]

  starWarsStory      StarWarsStory?
  starWarsNpcs       StarWarsNpc[]
  starWarsCombatants StarWarsCombatant[]
  starWarsSessions   StarWarsGameSession[]
  starWarsItems      StarWarsCampaignItem[]
  starWarsClues      StarWarsClue[]
  starWarsClocks     StarWarsClock[]
}

// ─── MESTRE D&D 5e ────────────────────────────────────────────────────────────

model DndCampaignStory {
  id             String @id @default(cuid())
  campaignId     String @unique
  objective      String @default("")
  purpose        String @default("")
  generalHistory String @default("")
  currentArc     String @default("")
  mainVillain    String @default("")

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
}

model DndNpc {
  id         String   @id @default(cuid())
  campaignId String
  name       String
  race       String   @default("")
  role       String   @default("")
  alignment  String   @default("")
  trait      String   @default("")
  appearance String   @default("")
  notes      String   @default("")
  hp         Int?
  ac         Int?
  str        Int?
  dex        Int?
  con        Int?
  int        Int?
  wis        Int?
  cha        Int?
  attacks    String   @default("[]") // JSON NPCAttack[]
  createdAt  DateTime @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
}

model DndCombatant {
  id            String  @id @default(cuid())
  campaignId    String
  characterId   String?
  name          String
  initiative    Int     @default(0)
  hp            Int?
  maxHp         Int?
  tempHp        Int     @default(0)
  ac            Int?
  conditions    String  @default("[]") // JSON string[]
  concentration Boolean @default(false)
  isPlayer      Boolean @default(false)
  order         Int     @default(0)

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
}

model DndGameSession {
  id          String   @id @default(cuid())
  campaignId  String
  number      Int      @default(1)
  name        String   @default("")
  objective   String   @default("")
  events      String   @default("")
  summary     String   @default("")
  sessionDate String   @default("")
  createdAt   DateTime @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
}

model DndCampaignItem {
  id          String  @id @default(cuid())
  campaignId  String
  name        String
  description String  @default("")
  type        String  @default("misc") // arma|armadura|magia|consumível|misc
  rarity      String  @default("comum")
  sessionId   String?

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
}

model DndClue {
  id         String   @id @default(cuid())
  campaignId String
  title      String   @default("")
  content    String   @default("")
  source     String   @default("")
  discovered Boolean  @default(false)
  sessionId  String?
  createdAt  DateTime @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
}

model DndClock {
  id         String   @id @default(cuid())
  campaignId String
  name       String   @default("")
  segments   Int      @default(4)
  filled     Int      @default(0)
  kind       String   @default("ameaca") // ameaca|missao|neutro
  notes      String   @default("")
  createdAt  DateTime @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
}

