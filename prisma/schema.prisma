// ─── MESTRE DE ORDEM PARANORMAL: dados da operação ────────────────────────────

model OrdemStory {
  id             String @id @default(cuid())
  campaignId     String @unique
  objective      String @default("")
  hook           String @default("")
  generalHistory String @default("")
  currentArc     String @default("")
  mainThreat     String @default("")
  membrana       String @default("danificada") // intacta|estavel|danificada|arruinada|rompida

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
}

model OrdemNpc {
  id             String   @id @default(cuid())
  campaignId     String
  name           String
  role           String   @default("")
  age            Int?
  gender         String   @default("")
  affiliation    String   @default("")
  description    String   @default("")
  personality    String   @default("")
  paranormalTies String   @default("")
  notes          String   @default("")
  agi            Int?
  forca          Int?
  int            Int?
  pre            Int?
  vig            Int?
  pv             Int?
  pe             Int?
  san            Int?
  defense        Int?
  attacks        String   @default("[]") // JSON: OrdemNPCAttack[]
  createdAt      DateTime @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
}

model OrdemCombatant {
  id          String  @id @default(cuid())
  campaignId  String
  characterId String? // vínculo com ficha real do jogador (import de PC)
  name        String
  init        Int     @default(0)
  pv          Int?
  maxPv       Int?
  pe          Int?
  maxPe       Int?
  san         Int?
  maxSan      Int?
  rd          Int     @default(0) // redução de dano
  isPlayer    Boolean @default(false)
  conditions  String  @default("[]") // JSON: string[] (ids de condição)
  order       Int     @default(0)

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
