# Banco de dados PostgreSQL
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/rpg_lab?schema=public"

# NextAuth v5 — gerar com: openssl rand -base64 32
AUTH_SECRET=""

# Necessário para rodar o build de produção fora da Vercel (ex.: `npm run start`
# local). Sem isto o NextAuth recusa o host e o login falha com UntrustedHost.
AUTH_TRUST_HOST="true"
